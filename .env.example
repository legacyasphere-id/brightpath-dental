# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI (via OpenRouter — openai/... model IDs, OpenRouter API key) ──
OPENAI_API_KEY=sk-or-...
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_CHAT_MODEL=openai/gpt-4o-mini

# ─── App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLINIC_NAME=BrightPath Dental
NEXT_PUBLIC_CLINIC_PHONE=+62-xxx-xxxx-xxxx
NEXT_PUBLIC_CLINIC_WHATSAPP=62xxxxxxxxxx

# ─── RAG Config ─────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.15

# ─── Admin ──────────────────────────────────────────────────
# Admin user is created via Supabase Auth dashboard
# Set these for seeding if needed
ADMIN_EMAIL=admin@brightpathdental.com
ADMIN_PASSWORD=change-me-in-production

# Comma-separated allowlist — any Supabase-authenticated user NOT on this
# list is signed out and sent back to /admin/login on every admin route
# and on /api/knowledge, even with a valid session. Keep this in sync
# with the admin_emails table from migration 006, which enforces the
# same allowlist at the database (RLS) layer.
ADMIN_EMAILS=admin@brightpathdental.com

# ─── Notifications ──────────────────────────────────────────
# Optional — fires a fire-and-forget webhook on new lead capture.
# Leave unset to skip notifications entirely.
MAKECOM_WEBHOOK_URL=

# ─── Rate limiting (Upstash Redis REST) ──────────────────────
# Optional — protects /api/chat and /api/leads from being hammered.
# Create a free Redis database at https://console.upstash.com and copy
# its REST URL/token here. If either is unset, rate limiting is skipped
# (a warning is logged once) rather than the routes failing closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
